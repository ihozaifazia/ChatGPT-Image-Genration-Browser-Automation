# Server config
PORT=3000

# Dedicated automation profile directory (separate from your real Chrome)
# Playwright creates its own Chrome instance here — your regular Chrome is NEVER closed.
PROFILE_PATH=./profiles/chatgpt-automation

# Temp folder for downloaded images (auto-cleaned after each request)
DOWNLOADS_PATH=./downloads

# Set to "true" to run browser headlessly (not recommended — ChatGPT may block it)
HEADLESS=false

# How long to wait for image generation before timing out (ms)
# ChatGPT image gen can take 30-90s — 3 minutes is safe
REQUEST_TIMEOUT_MS=180000

# Max retry attempts if image generation fails
MAX_RETRIES=3
